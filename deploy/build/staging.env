# Build-time values of the STAGING website image
# (ghcr.io/my-other-app/moa-website:staging-<sha>), for the staging Oracle box
# (https://staging.myotherapp.in). Same rules as production.env: public values
# only, KEY=value, no quotes. Built only when the repository variable
# STAGING_ENABLED is true (or by hand).

# ─── Required ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api-staging.myotherapp.in

# ─── Optional ────────────────────────────────────────────────────────────────
# The same Google client works once https://staging.myotherapp.in is one of
# its Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ANDROID_APP_SHA256=
# Razorpay TEST key id (rzp_test_...), never the live one.
NEXT_PUBLIC_RAZORPAY_KEY=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_RATE=
SENTRY_ORG=
SENTRY_PROJECT=
