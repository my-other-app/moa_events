# Build-time values of the PRODUCTION website image
# (ghcr.io/my-other-app/moa-website:<sha>), for the self-hosted Oracle box.
#
# The Docker build reads this file (Dockerfile: build secret `build_env`,
# passed by .github/workflows/image.yml). Everything here ends up in the
# browser bundles or in static files (the app-link files), so PUBLIC values
# only. Secrets are GitHub secrets instead: SENTRY_AUTH_TOKEN, API_SITE_TOKEN.
#
# KEY=value, no quotes, # comments. Copy each value from the Vercel project
# moa-events (Settings -> Environment Variables -> Production) before the
# first build: the Image workflow refuses to build production while a
# required one is empty. A change here needs a new image (and a deploy).
# Run-time settings live on the box instead (moa_backend:
# ops/server/env/website.env.example). Vercel never reads this file.

# ─── Required ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.myotherapp.in
# Google sign-in's web client id (empty: the site has no sign-in).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The Android app's signing-certificate SHA-256 fingerprints, comma-separated
# (empty: /.well-known/assetlinks.json is [] and Android opens links in the browser).
ANDROID_APP_SHA256=

# ─── Optional ────────────────────────────────────────────────────────────────
# Razorpay's publishable key id, for orders that do not bring their own.
NEXT_PUBLIC_RAZORPAY_KEY=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
# Sentry (empty DSN: off). The release is moa-events@<commit>, set by the build.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_RATE=
# Source maps upload only when these two and the SENTRY_AUTH_TOKEN secret are set.
SENTRY_ORG=
SENTRY_PROJECT=
# Demo clubs kept out of search engines; keep the same as env/website.env on the box.
# DEMO_NOINDEX=off
# DEMO_CLUB_SLUGS=
