# Copy to .env.local for `npm run dev` / `npm start`. Every variable is
# optional; the README's "Settings" table says what each does. NEXT_PUBLIC_*
# values are written into the browser bundle at build time.

# The API
NEXT_PUBLIC_API_BASE_URL=https://api.myotherapp.in
API_BASE_URL=
API_SITE_TOKEN=
REVALIDATE_SECRET=

# Sign-in, payments, the app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RAZORPAY_KEY=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
ANDROID_APP_SHA256=

# The demo clubs and search engines (left unset: an empty DEMO_CLUB_SLUGS means "no demo clubs")
# DEMO_NOINDEX=off
# DEMO_CLUB_SLUGS=borrow-checkers-kochi,neural-tide

# Sentry: off unless NEXT_PUBLIC_SENTRY_DSN is set.
NEXT_PUBLIC_SENTRY_DSN=
# Defaults: Vercel's environment (production / preview), else "local".
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Defaults: moa-events@<the commit Vercel builds>.
NEXT_PUBLIC_SENTRY_RELEASE=
# Share of page loads and requests traced, 0 to 1. Default 0.05.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Share of sessions with an error that are recorded (masked), 0 to 1. Default 0: no replay.
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_RATE=
# Build only, all three or none: upload the source maps to Sentry (then deleted from the build).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
